% Figure 3: logical structure. Solid: proved in the text. Dashed: rests on a computation.
\begin{tikzpicture}[
  font=\small,
  box/.style={draw, rounded corners=2pt, align=center, text width=#1, inner sep=4pt, fill=white},
  box/.default=4.0cm,
  comp/.style={box=#1, dashed, fill=gray!8},
  comp/.default=3.4cm,
  arr/.style={-{Stealth[length=2.2mm]}, thick}]
% main column
\node[box] (til) at (0,0) {Lemma 2.1: one starter tiles $K_{15\times4}$ by $28$ copies of $T(6)$; an $S(2,5,61)$};
\node[box] (etf) at (0,-1.8) {Prop.~3.1: the two-graph $\Omega$ on $496$ points, eigenvalues $33$, $-15$};
\node[box, fill=pA!12] (thm) at (0,-3.6) {\textbf{Theorem 4.1}: $\srg(496,231,102,112)$};
\node[comp=4.0cm] (rec) at (0,-5.4) {Lemma 5.1: $\Omega$ determines the cells, the design and the labels (finite check)};
\node[box, fill=pA!12] (cnt) at (0,-7.4) {\textbf{Theorem 5.2}: more than $7.06\cdot10^{107}$ classes in each of the three rows};
% left column
\node[comp] (more) at (-4.6,0) {Remark 2.2: two more starters (search); three designs, $|\Aut|=84$};
\node[comp] (sp) at (-4.6,-5.4) {Prop.~7.1: not the symplectic two-graph};
\node[comp] (rk) at (-4.6,-7.4) {GF$(2)$ ranks $22,19,19$ of the crossing matrices};
% right column
\node[comp] (half) at (4.6,-1.8) {Prop.~3.2: half of the Steiner frame of the $S(2,5,61)$};
\node[box=3.4cm] (oth) at (4.6,-3.6) {Section 5: $\srg(496,240,120,112)$ and descendants $\srg(495,238,109,119)$};
\node[comp] (sym) at (4.6,-5.6) {Prop.~6.1: nine two-graphs with $|\Aut\Omega|=84$; Burnside count};
% arrows
\draw[arr] (til) -- (etf); \draw[arr] (etf) -- (thm); \draw[arr] (thm) -- (rec); \draw[arr] (rec) -- (cnt);
\draw[arr, dashed] (more) -- (til);
\draw[arr] (etf) -- (half);
\draw[arr] (etf.south east) -- (oth.north west);
\draw[arr] (oth) -- (sym);
\draw[arr] (oth.south west) -- (cnt.north east);
\draw[arr, dashed] (rec) -- (sp);
\draw[arr, dashed] (rk) -- (cnt);
% legend
\node[box=2.0cm, inner sep=3pt, font=\scriptsize] (lg1) at (-1.3,-9.0) {proved in the text};
\node[comp=3.0cm, inner sep=3pt, font=\scriptsize] at (1.6,-9.0) {rests on a computation};
\end{tikzpicture}
