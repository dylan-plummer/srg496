% Figure 1: (a) the shape of the 183 x 496 matrix F, (b) one tile block of one point, entry by entry.
\begin{tikzpicture}[font=\small, x=1cm, y=1cm,
  brace/.style={decorate, decoration={brace, amplitude=4pt}, thick},
  lab/.style={font=\scriptsize, align=center},
  pm/.style={font=\scriptsize}]
% ================= (a) shape of F =================
% columns: inf [0,1.8], p [1.8,2.8], q [2.8,3.8], dots [3.8,5.0], last point [5.0,5.8]
% rows: parts [0,-1.2]; tiles: T [-1.2,-1.8], T' [-1.8,-2.4], dots [-2.4,-3.6], last tile [-3.6,-4.2]
\fill[pB!40] (0,0) rectangle (1.8,-1.2);
% part rows: one row of ones per point
\fill[pA!70] (1.8,-0.25) rectangle (2.8,-0.35);
\fill[pA!70] (2.8,-0.65) rectangle (3.8,-0.75);
\fill[pA!70] (5.0,-0.95) rectangle (5.8,-1.05);
% tile T contains p and q; tile T' contains p only; the last tile contains the last point
\foreach \x/\w/\ya/\yb in {1.8/1.0/-1.3/-1.5, 2.8/1.0/-1.2/-1.6, 1.8/1.0/-1.9/-2.2, 5.0/0.8/-3.8/-4.1} {
  \fill[pC!80] (\x,\ya) rectangle ++(\w,-0.1);
  \fill[pC!80] (\x,\yb) rectangle ++(\w,-0.1);}
% grid
\draw (0,0) rectangle (5.8,-4.2);
\foreach \x in {2.8,3.8,5.0} \draw[gray] (\x,0) -- (\x,-4.2);
\foreach \y in {-1.8,-2.4,-3.6} \draw[gray] (0,\y) -- (5.8,\y);
\draw[thick] (0,-1.2) -- (5.8,-1.2);
\draw[thick] (1.8,0) -- (1.8,-4.2);
\node at (4.4,-0.6) {$\cdots$}; \node at (4.4,-3.0) {$\cdots$}; \node at (2.3,-3.0) {$\vdots$}; \node at (0.9,-2.7) {$0$};
% zoom marker
\draw[pD, very thick, dashed] (1.75,-1.15) rectangle (2.85,-1.85);
% column braces
\draw[brace] (0,0.1) -- node[lab, above=5pt] {$16$ columns\\ at $\infty$} (1.8,0.1);
\draw[brace] (1.8,0.1) -- node[lab, above=5pt] {$8$ at $p$} (2.8,0.1);
\draw[brace] (2.8,0.1) -- node[lab, above=5pt] {$8$ at $q$} (3.8,0.1);
\draw[brace] (3.8,0.1) -- node[lab, above=5pt] {$8$ at each\\ other point} (5.8,0.1);
% row braces
\draw[brace] (-0.1,-1.2) -- node[lab, left=5pt] {$15$ part rows} (-0.1,0);
\draw[brace] (-0.1,-1.8) -- node[lab, left=5pt] {tile $T$\\ ($6$ rows)} (-0.1,-1.2);
\draw[brace] (-0.1,-2.4) -- node[lab, left=5pt] {tile $T'$} (-0.1,-1.8);
\draw[brace] (-0.1,-4.2) -- node[lab, left=5pt] {the other\\ $26$ tiles} (-0.1,-2.4);
\node at (2.9,-4.75) {(a) the shape of $F$};
% ================= (b) zoom: point p in tile T =================
\begin{scope}[xshift=8.1cm, yshift=0.2cm, x=0.42cm, y=0.42cm]
  % columns x = 000..111, chi_c(x) for c = 011: + - - + + - - +
  \foreach \k/\b in {0/000,1/001,2/010,3/011,4/100,5/101,6/110,7/111}
    \node[font=\tiny, rotate=90, anchor=west] at (\k+0.5,0.2) {\b};
  \node[lab, anchor=south] at (4,1.9) {the $8$ columns at $p$};
  % part row of p
  \foreach \k in {0,...,7} {\fill[pA!25] (\k,-0.6) rectangle ++(1,-1); \node[pm] at (\k+0.5,-1.1) {$1$};}
  \draw (0,-0.6) rectangle (8,-1.6);
  \node[lab, anchor=east] at (-0.2,-1.1) {row of the\\ part of $p$};
  % tile block rows 0..5, starting at y=-2.4
  \foreach \r in {0,...,5} \node[pm, anchor=east] at (-0.2,-2.9-\r) {\r};
  \node[lab, anchor=east] at (-1.0,-5.4) {tile $T$};
  \foreach \k/\s/\t in {0/+/-,1/-/+,2/-/+,3/+/-,4/+/-,5/-/+,6/-/+,7/+/-} {
    \fill[pC!30] (\k,-3.4) rectangle ++(1,-1);
    \node[pm] at (\k+0.5,-3.9) {$\s$};
    \fill[pC!30] (\k,-5.4) rectangle ++(1,-1);
    \node[pm] at (\k+0.5,-5.9) {$\t$};}
  \foreach \r in {0,2,4,5} \foreach \k in {0,...,7} \node[pm, gray] at (\k+0.5,-2.9-\r) {$0$};
  \draw (0,-2.4) rectangle (8,-8.4);
  \foreach \y in {-3.4,-4.4,-5.4,-6.4,-7.4} \draw[gray!50] (0,\y) -- (8,\y);
  \foreach \x in {1,...,7} \draw[gray!50] (\x,-0.6) -- (\x,-1.6) (\x,-2.4) -- (\x,-8.4);
  \node[lab, anchor=west] at (8.3,-3.9) {$\chi_c(x)$};
  \node[lab, anchor=west] at (8.3,-5.9) {$-\chi_c(x)$};
  \draw[pD, very thick, dashed] (-0.1,-2.3) rectangle (8.1,-8.5);
  \node at (4,-9.6) {(b) $p=\{1,3\}$ in $T$, label $c=011$};
\end{scope}
\end{tikzpicture}
